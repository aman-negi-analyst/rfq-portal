# ============================================================
#  RFQ Portal — Environment Variables
#  Copy this file to .env and fill in all values before running.
# ============================================================

# ── Required ──────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── Database ──────────────────────────────────────────────
# SQLite (development only):
#   DATABASE_URL=sqlite:///rfq_portal.db
# PostgreSQL (production):
#   DATABASE_URL=postgresql://user:password@localhost:5432/rfq_db
DATABASE_URL=sqlite:///rfq_portal.db

# ── App environment ───────────────────────────────────────
# Set to "production" to enable HTTPS enforcement, secure cookies, HSTS
FLASK_ENV=development
# Set to "1" to enable Flask debug mode (NEVER in production)
FLASK_DEBUG=0

# ── Server ────────────────────────────────────────────────
PORT=5000

# ── Public base URL (used in email links) ────────────────
# Must be the full public URL vendors will receive in emails.
# Example: https://rfq.yourcompany.com
BASE_URL=http://localhost:5000

# ── Admin account ─────────────────────────────────────────
# Email for the auto-created admin account (first run only)
ADMIN_EMAIL=admin@yourcompany.com
