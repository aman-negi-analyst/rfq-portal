[Unit]
Description=RFQ Portal (gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/path/to/rfq_production
EnvironmentFile=/path/to/rfq_production/.env
ExecStart=/path/to/venv/bin/gunicorn -c gunicorn.conf.py app:app
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
